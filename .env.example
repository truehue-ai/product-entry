# Meta Marketing API (server-side only — never prefix with NEXT_PUBLIC_)
META_TOKEN_PARAM=/truehue/meta/access-token   # SSM SecureString holding the system user token (ads_read); read via AWS_ROLE_ARN
META_AD_ACCOUNT_ID=         # act_XXXX
META_API_VERSION=v26.0
META_IG_USER_ID=            # optional — Instagram professional account id; otherwise found via the token's Pages

# Login sessions
SESSION_SECRET=             # at least 32 random characters — signs the session cookie (openssl rand -base64 48)
LOGIN_PASSWORD_DHRUVI=      # login passwords, checked on the server
LOGIN_PASSWORD_AASTHA=
LOGIN_PASSWORD_RIDDHI=      # Meta Ads only
LOGIN_PASSWORD_JAGAT=       # Meta Ads only
